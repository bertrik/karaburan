<?xml version="1.0"?>
<sdf version="1.10">
  <model name="harbour_reverse_straight">
    <static>true</static>
    <!-- A symmetric U-shaped berth: both arcs hit a side wall, while the
         shortest clear departure is straight astern. -->
    <link name="quay">
      <collision name="front_collision">
        <pose>1.25 0 0.5 0 0 0</pose>
        <geometry><box><size>0.30 2.60 1.0</size></box></geometry>
      </collision>
      <visual name="front_visual">
        <pose>1.25 0 0.5 0 0 0</pose>
        <geometry><box><size>0.30 2.60 1.0</size></box></geometry>
      </visual>
      <collision name="port_collision">
        <pose>-0.65 1.15 0.5 0 0 0</pose>
        <geometry><box><size>3.80 0.30 1.0</size></box></geometry>
      </collision>
      <visual name="port_visual">
        <pose>-0.65 1.15 0.5 0 0 0</pose>
        <geometry><box><size>3.80 0.30 1.0</size></box></geometry>
      </visual>
      <collision name="starboard_collision">
        <pose>-0.65 -1.15 0.5 0 0 0</pose>
        <geometry><box><size>3.80 0.30 1.0</size></box></geometry>
      </collision>
      <visual name="starboard_visual">
        <pose>-0.65 -1.15 0.5 0 0 0</pose>
        <geometry><box><size>3.80 0.30 1.0</size></box></geometry>
      </visual>
    </link>
  </model>
</sdf>
