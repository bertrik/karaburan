<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>karaburan_navigation_tests</name>
  <version>0.0.0</version>
  <description>Repeatable navigation system tests for Karaburan.</description>
  <maintainer email="mleegwt@users.noreply.github.com">pi</maintainer>
  <license>TODO: License declaration</license>

  <depend>action_msgs</depend>
  <depend>ament_index_python</depend>
  <depend>geometry_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rclpy</depend>
  <depend>sensor_msgs</depend>

  <exec_depend>karaburan_simulation</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>navigation</exec_depend>
  <exec_depend>python3-junit2html</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
